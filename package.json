{
  "name": "rp-fieldtech-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile web agent for Repeat Precision field technicians to ask about PurpleSeal/PurpleReign products and procedures.",
  "scripts": {
    "build-knowledge": "python scripts/build-knowledge.py",
    "dev": "wrangler pages dev public --compatibility-date=2024-09-23",
    "deploy": "wrangler pages deploy public --project-name=rp-fieldtech",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
